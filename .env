# Backend API — for local dev use localhost, for production use the real domain
NEXT_PUBLIC_API_URL=http://localhost:8000

# Facebook Pixel ID (public — safe to expose)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=YOUR_FACEBOOK_PIXEL_ID

# TikTok Pixel ID (public — safe to expose)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=YOUR_TIKTOK_PIXEL_ID
